# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# LLM Providers (fallback chain order: deepseek -> minimax -> claude)
MINIMAX_API_KEY=your_key_here
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_ENDPOINT=https://api.minimaxi.com/v1/text/chatcompletion_v2
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=your_key_here
LLM_MONTHLY_BUDGET_USD=800
LLM_BUDGET_ALARM_THRESHOLD=0.8
LLM_BUDGET_AUTOPAUSE_THRESHOLD=0.95

# Debug only: set to "1" to disable chat LLM response cache
CHAT_CACHE_DISABLED=

# Market Data
COINGECKO_API_KEY=your_demo_key_here

# News sources (multi-chain)
CRYPTOCOMPARE_API_KEY=your_cryptocompare_key_here
COINGECKO_DEMO_KEY=your_coingecko_demo_key_here
FORESIGHTNEWS_TOKEN=your_token_here
NEWS_PRIMARY_SOURCE=cryptocompare
NEWS_USAGE_BAND=low
NEWS_ENABLE_STANDBY_SOURCES=0
CRYPTOPANIC_API_KEY=your_cryptopanic_key_here
CRON_SECRET=your_32_byte_hex_secret_here
