# Production KV metrics sink. Configure these in Vercel; do not commit real values.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# LLM provider defaults. Configure real keys in Vercel; do not commit values.
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash
LLM_MONTHLY_BUDGET_USD=800
LLM_BUDGET_ALARM_THRESHOLD=0.8
LLM_BUDGET_AUTOPAUSE_THRESHOLD=0.95

# Watch team-mode contracts. Default false; spec-1/spec-2 do not expose team UI.
NEXT_PUBLIC_WATCH_TEAM_MODE=false
